URL = 'https://www.scrapethissite.com/pages/simple/'
res = requests.get(URL) # it will send request to the url


if res.status_code == 200: # status_code (200/400/404 etc)
    print(res.text) # the HTML content in string
else:
    print("Failed to fetch page!!")


print(res.content)


print(res.headers)


with open('scraped_data/data1.html', 'w', encoding='utf-8') as f:
    f.write(res.text)





from bs4 import BeautifulSoup


with open("scraped_data/data1.html",'r') as f:
    html_content = f.read()
soup = BeautifulSoup(html_content, 'lxml')


soup


soup.find("h1")


soup.find("h3")
#or
soup.h1


all_h3 = soup.find_all("h3")
type(all_h3)


all_countries = []
for h3 in all_h3:
    name = h3.get_text(strip=True)
    #h3.find_parent("div")["class"])
    population = h3.find_next("div").select("span.country-population")[0].get_text(strip=True)
    #print(h3.attrs)
    all_countries.append([name, population])


all_countries


df = pd.DataFrame(all_countries, columns=['Name','Population'])
df


df.to_csv("cleaned_data/data.csv", index=False)


