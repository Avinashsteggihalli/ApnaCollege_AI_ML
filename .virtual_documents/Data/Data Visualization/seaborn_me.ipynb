import seaborn as sns
import matplotlib.pyplot as plt


sns.set_theme()


sns.get_dataset_names()


tips = sns.load_dataset("tips")
print(type(tips))
print(tips.head())


sns.relplot(
    data=tips,
    x='total_bill',
    y='tip'
)


sns.set_theme(style='ticks')
sns.relplot(
    data=tips,
    x='total_bill',
    y='tip'
)


sns.set_theme(style='dark')
sns.relplot(
    data=tips,
    x='total_bill',
    y='tip'
)


sns.set_theme(style='darkgrid')
sns.relplot(
    data=tips,
    x='total_bill',
    y='tip'
)


sns.set_theme(style='whitegrid')
sns.relplot(
    data=tips,
    x='total_bill',
    y='tip'
)


#scatter plot

# load data
tips = sns.load_dataset("tips")

#plot
sns.scatterplot(
    data=tips,
    x='total_bill',
    y='tip',
    hue='time'
)


# lineplot
sns.lineplot(
    data=tips,
    x='total_bill',
    y='tip',
)


# lineplot
flights = sns.load_dataset('flights')

print(flights.head())


sns.lineplot(
    data=flights,
    x='year',
    y='passengers',
)


print(tips.head())


sns.barplot(
    data=tips,
    x='day',
    y='tip',
    hue='sex'
)


sns.boxplot(
    data=tips,
    x='day',
    y='tip'
)


# distribution plots (histogram)

penguins = sns.load_dataset("penguins")
penguins.head()


sns.histplot(
    data=penguins,
    x='body_mass_g',
    bins=20
)


# matrix plot
# heatmap

flight_pivot = flights.pivot(index="month",columns="year",values="passengers")

sns.heatmap(
    flight_pivot,
    cmap="coolwarm",
    annot=True,
    fmt='d'
)

plt.title("Passengers Heatmap")
plt.tight_layout()


# best practice
fig, ax = plt.subplot()

sns.lineplot(
    data=tips,
    x='day',
    y='total_bill',
    hue='sex',
    ax=ax,
    ci=None
)

ax.set_title("Avg bill value for each day")
ax.set_xlabel("Days")
ax.set_ylabel("Total Bill")

    



