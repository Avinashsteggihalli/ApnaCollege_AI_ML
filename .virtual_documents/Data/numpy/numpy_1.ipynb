# slicing
arr = np.array([1,2,3,4,5,6])
# [start, end, step]
print(arr[2:4]) # 3rd to 4th element
print(arr[:]) # start to end
print(arr[1:]) # 2d element to end
print(arr[:3]) # start to 3rd element
print(arr[1::2]) # 2nd to last with step of 2
print(arr[::]) # start to end
print(arr[-1]) # last element
print(arr[::-1]) # reverse order with step 1
print(arr[::-2]) # reverse order with step 2


# copy vs view
# in list
