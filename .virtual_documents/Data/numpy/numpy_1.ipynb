import numpy as np
import time


arr = np.array([1,2,3,4,5])
print(arr, type(arr))





# execution time numpy vs python list
size = 1_000_0000

try:
    #python list
    if size <= 1_000_0000:
        py_list = list(range(size))  
    else:
        print("Too much size!! to handle")
    start_time = time.time()
    sq_list = [x**2 for x in py_list]
    end_time = time.time()
    #np array
    if size <= 1_000_0000:
        np_array = np.array(range(size))  
    else:
        print("Too much size!! to handle")
    start_time2 = time.time()
    # vectorisation
    sq_array = np_array ** 2
    end_time2 = time.time()
    np_time = round(end_time2 - start_time2, 4)
    list_time = round(end_time - start_time , 4)
    print(f"Numpy Array time = {np_time} seconds")
    
    print(f"Python List time = {list_time} seconds")
    speed = "Numpy Array is speed" if np_time < list_time else "Python List is speed"
    print(speed)
except TypeError:
    print("Give size range less than 1_00_0000")





import sys

#memory
py_list_data = sys.getsizeof(py_list) * len(py_list) # to find size of python list using sys package in bytes
print(f"Python list size = {py_list_data} bytes")

np_data = np_array.nbytes # to find numpy size in bytes
print(f"Numpy array size = {np_data} bytes")

memory = "\nNumpy Array occupy less memory than Py_list " if np_data < py_list_data else "\nPython List occupy less memory"
print(memory)





