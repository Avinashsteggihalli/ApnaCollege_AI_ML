print(f"(Row:{row},Col:{col})")
print(arr_one2, arr_one2.shape)


# create value (ex: 100)
arr_val = np.full((3,4), 100) # prefilled with value
print(arr_val)
row , col = arr_val.shape
print(f"(Row:{row},Col:{col})")


# create indentity matrix
