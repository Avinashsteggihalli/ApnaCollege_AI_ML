sub_array[0] = 200
print(sub_array)
print(lst_arry)


# in array with .copy()
lst_arry = np.array([1,2,3,4,5])
sub_array = lst_arry[1:3].copy() # this will copy the sub array of array
print(sub_array)
sub_array[0] = 200
print(sub_array)
print(lst_arry)





