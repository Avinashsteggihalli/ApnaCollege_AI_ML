





import pandas as pd


iris_data = pd.read_csv("IRIS.csv")


iris_data


# A
iris_data[0:11] # 0 to 10th rows


iris_data.shape # rows x cols


iris_data.dtypes # data types of all cols


iris_data.describe() # Summary statistics


# B
iris_data[iris_data["petal_length"] > 4.5] # petals > 4.5


iris_data[iris_data["species"] == "Iris-virginica"]


iris_data.groupby("species")["sepal_length"].mean()


iris_data.groupby("species")["petal_width"].max()


iris_data.groupby("species")["sepal_width"].std()


# D
iris_data["petal_ratio"] = iris_data["petal_length"]/iris_data["petal_width"]
iris_data # new col with above formula


iris_data.groupby("species").agg(average_ratio=("petal_ratio","mean")) # for each specis, avg petal_ratio








