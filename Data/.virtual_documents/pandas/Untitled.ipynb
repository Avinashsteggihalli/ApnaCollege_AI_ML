import pandas as pd


info = {
    "Name" : ["Avinash","Akhbar","Amar","Antony"],
    "CGPA" : [99.9,97.5,98.5,87.7]
}
df = pd.DataFrame(info) # it will make the dict as table (strctured way)

print(df)


df #dataframe


# Series
s = pd.Series([1,2,3,4,5])
print(s)
type(s)


#index (index based access)
print(s[2])
print(s[0])


# labelled based access
s = pd.Series([1,2,3,4], index=["Avinash","Charlie","Sheldon","Lenord"])
print(s)
print('\n')
print(s["Sheldon"])


# Properties
# 1. Homogenous
s = pd.Series([1,2,3,4,"abc"], index=["Avinash","Charlie","Sheldon","Lenord",123])
print(s)


# 2. Vectorized Operations
s1 = pd.Series([1,2,3,4,5,6,7])
s2 = pd.Series([5,6,7,8,9,10,11])
print(s1 + s2)


# Handle Mising Value with NaN
s1 = pd.Series([1,2,3,4])
s2 = pd.Series([5,6,7,8,9,10,11])
print(s1 + s2)


# Mutable values, immutable size
s1 = pd.Series([1,2,3,4])
print(s1) # origial series
s1[0] = 100
changed_s = s1.drop(0)
print(s1) # after 
print(changed_s) # changed series droping 1 index


# Data Frame
info = {
    "Name": ["Avinash","Bob","Charlie","Sheldon"],
    "Age":[24,54,12,45],
    "CGPA":[98,34,56,1]
}

df = pd.DataFrame(info)
print(df)



